.error-banner { background: rgba(127, 29, 29, 0.3); border: 1px solid rgba(=
248, 113, 113, 0.45); color: rgb(254, 202, 202); }

.error-banner p { margin: 0px; }

.error-meta, .error-trace { display: flex; flex-wrap: wrap; gap: 8px; font-=
size: 0.82rem; margin-top: 6px !important; }

.error-details { margin-top: 8px; font-size: 0.82rem; }

.error-details summary { cursor: pointer; }

.error-details dl { display: grid; grid-template-columns: max-content 1fr; =
gap: 4px 10px; margin: 8px 0px 0px; }

.error-details dl div { display: contents; }

.error-details dt { font-weight: 700; }

.error-details dd { margin: 0px; overflow-wrap: anywhere; }

.results-header { display: flex; align-items: center; justify-content: spac=
e-between; gap: 12px; margin-bottom: 18px; }

.empty-state, .loading-box { display: flex; align-items: center; justify-co=
ntent: center; min-height: 160px; border: 1px dashed rgba(148, 163, 184, 0.=
25); border-radius: 14px; color: rgb(203, 213, 225); background: rgba(15, 2=
3, 42, 0.35); }

.loading-box { gap: 12px; }

.spinner { width: 18px; height: 18px; border-radius: 50%; border-width: 2px=
; border-style: solid; border-color: rgb(125, 211, 252) rgba(125, 211, 252,=
 0.4) rgba(125, 211, 252, 0.4); border-image: none; animation: 1s linear 0s=
 infinite normal none running spin; }

@keyframes spin {=20
  100% { transform: rotate(360deg); }
}

.result-summary { display: grid; grid-template-columns: repeat(2, minmax(0p=
x, 1fr)); gap: 18px; margin-bottom: 18px; padding: 12px 14px; border-radius=
: 12px; background: rgba(15, 23, 42, 0.55); }

.muted-label { display: block; font-size: 0.72rem; letter-spacing: 0.08em; =
text-transform: uppercase; color: rgb(147, 197, 253); margin-bottom: 8px; }

.result-summary p { margin: 0px; color: rgb(226, 232, 240); }

.table-wrap { overflow: auto; border: 1px solid rgba(148, 163, 184, 0.15); =
border-radius: 12px; background: rgba(15, 23, 42, 0.55); }

table { width: 100%; border-collapse: collapse; min-width: 500px; }

th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid rgb=
a(148, 163, 184, 0.1); }

th { background: rgba(30, 41, 59, 0.9); color: rgb(219, 234, 254); font-siz=
e: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; }

.sql-panel { margin-top: 18px; background: rgba(7, 12, 19, 0.6); border: 1p=
x solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 14px; }

.sql-panel h4 { margin: 0px 0px 10px; color: rgb(226, 232, 240); }

.sql-panel pre { margin: 0px; white-space: pre-wrap; word-break: break-word=
; color: rgb(191, 219, 254); font-family: Consolas, monospace; }

.loading-text, .empty-text { color: rgb(203, 213, 225); font-size: 0.9rem; =
}

@media (max-width: 900px) {
  .app-shell { grid-template-columns: 1fr; }
  .hero-panel, .results-header { flex-direction: column; align-items: flex-=
start; }
  .result-summary { grid-template-columns: 1fr; }
}
